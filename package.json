{
   "name": "@acegoal07/taac",
   "version": "1.0.2",
   "description": "A CLI tool for creating, accessing and managing docker based clusters",
   "author": "acegoal07",
   "license": "MIT",
   "repository": {
      "type": "git",
      "url": "git+https://github.com/acegoal07/taac.git"
   },
   "homepage": "https://github.com/acegoal07/taac",
   "bugs": "https://github.com/acegoal07/taac/issues",
   "publishConfig": {
      "access": "public"
   },
   "keywords": [
      "cli",
      "docker",
      "docker-compose",
      "cluster",
      "oclif"
   ],
   "main": "dist/index.js",
   "types": "dist/index.d.ts",
   "bin": {
      "taac": "bin/run.js"
   },
   "files": [
      "bin",
      "dist",
      "oclif.manifest.json"
   ],
   "engines": {
      "node": ">=24.0.0"
   },
   "dependencies": {
      "@oclif/core": "^5.0.0",
      "@oclif/plugin-help": "^7.0.0",
      "cli-table3": "^0.6.5",
      "docker-compose": "^1.4.2",
      "dockerode": "^5.0.1",
      "env-paths": "^4",
      "eta": "^4.6.0",
      "ssh2": "^1.17.0"
   },
   "devDependencies": {
      "@eslint/config-helpers": "^0.7.0",
      "@types/dockerode": "^4.0.1",
      "@types/ssh2": "^1.15.5",
      "eslint": "^10.10.0",
      "eslint-config-oclif": "^7.1.7",
      "eslint-config-prettier": "^10",
      "eslint-plugin-unused-imports": "^4.4.1",
      "oclif": "^6.0.0",
      "prettier": "^3",
      "shx": "^0.4.0",
      "typescript": "^5"
   },
   "oclif": {
      "bin": "taac",
      "dirname": "taac",
      "commands": "./dist/commands",
      "plugins": [
         "@oclif/plugin-help"
      ],
      "topics": {
         "cluster": {
            "description": "Commands used to create and manipulate clusters"
         },
         "destroy": {
            "description": "Commands used to destroy clusters and manage clean up their files"
         },
         "ssh": {
            "description": "Commands to access the taac clusters"
         }
      }
   },
   "scripts": {
      "build": "shx rm -rf dist && tsc -b && shx mkdir -p dist/assets && shx cp -r src/assets/setup_scripts dist/assets/ && shx cp -r src/assets/templates dist/assets/ && shx cp -r src/assets/docker dist/assets/",
      "lint": "eslint src/",
      "lint:fix": "eslint src/ --fix",
      "format": "prettier . --write",
      "prepack": "oclif manifest && oclif readme",
      "postpack": "shx rm -f oclif.manifest.json"
   },
   "prettier": {
      "semi": true,
      "singleQuote": true,
      "trailingComma": "none",
      "printWidth": 100,
      "tabWidth": 3
   }
}
