ARG SLURM_VERSION=26.05.1

# ==========================================
# BUILD STAGE
# ==========================================
FROM rockylinux:10 AS builder

ARG SLURM_VERSION

RUN dnf -y install dnf-plugins-core && \
  dnf config-manager --set-enabled crb && \
  dnf -y install epel-release && \
  dnf -y update && \
  dnf clean all

# Build dependencies only
RUN --mount=type=cache,target=/var/cache/dnf \
  dnf -y install \
  gcc gcc-c++ make wget tar bzip2 \
  openssl-devel readline-devel ncurses-devel \
  perl munge-devel mariadb-devel \
  json-c-devel llhttp-devel libyaml-devel \
  dbus-devel \
  && dnf clean all

WORKDIR /usr/src

# Download and compile Slurm
RUN wget -O slurm.tar.bz2 \
  https://download.schedmd.com/slurm/slurm-${SLURM_VERSION}.tar.bz2 && \
  tar -xjf slurm.tar.bz2 && \
  cd slurm-${SLURM_VERSION} && \
  ./configure \
  --prefix=/usr/local/slurm \
  --sysconfdir=/etc/slurm \
  --with-munge \
  --with-mysql \
  --with-llhttp-parser \
  --disable-dependency-tracking && \
  make -j"$(nproc)" && \
  make install && \
  rm -rf /usr/src/*


# ==========================================
# RUNTIME BASE
# ==========================================
FROM rockylinux:10 AS runtime

# Enable CRB and EPEL 10
RUN dnf -y install dnf-plugins-core && \
  dnf config-manager --set-enabled crb && \
  dnf -y install epel-release && \
  dnf config-manager --set-enabled epel && \
  dnf clean all

# Runtime libraries ONLY - no compilers or headers
RUN dnf install -y \
  munge \
  openssl-libs \
  readline \
  json-c \
  llhttp \
  libyaml \
  dbus-libs \
  mariadb-connector-c \
  openssh-server \
  openssh-clients \
  ncurses \
  sudo \
  && dnf clean all

COPY --from=builder /usr/local/slurm /usr/local/slurm

RUN groupadd -r slurm && \
  useradd -r -g slurm slurm && \
  mkdir -p \
  /etc/slurm \
  /var/log/slurm \
  /var/log/munge \
  /var/lib/munge \
  /run/munge \
  /etc/munge \
  /slurm/state \
  /slurm/spool && \
  chown -R munge:munge \
  /var/log/munge \
  /var/lib/munge \
  /run/munge \
  /etc/munge && \
  chown -R slurm:slurm /var/log/slurm /slurm && \
  useradd -m dev && \
  mkdir -p /etc/sudoers.d && \
  echo "dev ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/dev && \
  chmod 0440 /etc/sudoers.d/dev

ENV PATH="/usr/local/slurm/bin:/usr/local/slurm/sbin:$PATH"

RUN echo \
  'export PATH=/usr/local/slurm/bin:/usr/local/slurm/sbin:$PATH' \
  > /etc/profile.d/slurm.sh

RUN echo 'CgroupPlugin=disabled' > /etc/slurm/cgroup.conf

RUN dnf -y upgrade && \
  dnf clean all

# Global custom commands
<% for (const command of it.commands) { %>
RUN <%= command %>
<% } %>

# Global custom packages
<% if (it.packages.length > 0) { %>
RUN dnf install -y <%= it.packages.join(' ') %> && \
  dnf clean all
<% } %>

WORKDIR /


# ==========================================
# LOGIN IMAGE
# ==========================================
FROM runtime AS login

COPY entrypoint-login.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

EXPOSE 22
CMD ["/entrypoint.sh"]


# ==========================================
# COMPUTE IMAGE
# ==========================================
FROM runtime AS compute

COPY entrypoint-compute.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

EXPOSE 22
CMD ["/entrypoint.sh"]


# ==========================================
# DATABASE IMAGE
# ==========================================
FROM runtime AS database

RUN dnf install -y mariadb-server && \
  dnf clean all

COPY entrypoint-database.sh /entrypoint.sh
COPY setup_scripts/database.sh /tmp/setup_scripts/database.sh

RUN chmod +x \
  /entrypoint.sh \
  /tmp/setup_scripts/database.sh

CMD ["/entrypoint.sh"]
